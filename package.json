{
  "name": "daily-news",
  "version": "2.0.0",
  "private": true,
  "description": "Plataforma de notícias e publicações técnicas com React + Laravel + PostgreSQL + pgAdmin",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && php artisan serve",
    "build": "npm run build --prefix frontend",
    "db:migrate": "cd backend && php artisan migrate",
    "db:seed": "cd backend && php artisan migrate:fresh --seed"
  },
  "keywords": [
    "react",
    "laravel",
    "postgresql",
    "pgadmin",
    "vite",
    "typescript",
    "daily-news"
  ],
  "author": "Matheus Arruda",
  "license": "MIT"
}
